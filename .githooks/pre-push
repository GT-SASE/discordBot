#!/bin/sh
# Scans the commits being pushed for secrets, and blocks the push on a finding.
# Activate with: npm run hooks:install
remote="$1"
repo_root="$(git rev-parse --show-toplevel)" || exit 1
gitleaks="${repo_root}/.tools/gitleaks"
if [ ! -x "${gitleaks}" ]; then
  echo "pre-push: gitleaks is not installed. Run: npm run gitleaks:install" >&2
  exit 1
fi
# gitleaks would read it and skip the findings it lists.
if [ -e "${repo_root}/.gitleaksignore" ]; then
  echo "pre-push: remove .gitleaksignore. Fix a finding, never ignore it." >&2
  exit 1
fi
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "${local_sha}" = "${zero}" ] && continue # A delete sends no commits.
  if [ "${remote_sha}" = "${zero}" ]; then
    range="${local_sha} --not --remotes=${remote}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  # Two passes: the default rules, then the project's own rules, which must not
  # inherit the default allowlist (it skips lockfiles and binary files).
  for config in .gitleaks.toml .gitleaks-custom.toml; do
    "${gitleaks}" git "${repo_root}" --config "${repo_root}/${config}" \
      --redact --ignore-gitleaks-allow --no-banner \
      --log-opts="${range} -m --text --no-color" </dev/null || exit 1
  done
done
