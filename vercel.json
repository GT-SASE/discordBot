{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 15 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "api/cron/reminders.ts": { "maxDuration": 60 },
    "api/interactions.ts": { "maxDuration": 60 }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  }
}
