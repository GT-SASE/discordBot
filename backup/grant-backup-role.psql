-- Gives backup_ro its read access on a recovered project, after the restore. The restore
-- filter drops policies, because the right ones depend on what the new project allows, so
-- this works them out from the catalog. A table added by any migration is covered with no
-- change here, which rerunning migration files could never promise.
--
-- Safe to run more than once. Run it as the owner of the tables, in one transaction. It ends
-- by refusing to finish if any table is still closed to the role. Plain SQL only, so the
-- tests can run this same file.

GRANT USAGE ON SCHEMA public, history TO backup_ro;
GRANT SELECT ON ALL TABLES IN SCHEMA public, history TO backup_ro;
-- pg_dump reads each identity sequence's position. SELECT does not allow nextval.
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public, history TO backup_ro;

-- The backup job records the applied migrations in each manifest. The Supabase CLI creates
-- this table, and in a recovery that happens after the restore, so run this file after
-- recording them.
DO $$
BEGIN
  IF pg_catalog.to_regclass('supabase_migrations.schema_migrations') IS NOT NULL THEN
    GRANT USAGE ON SCHEMA supabase_migrations TO backup_ro;
    GRANT SELECT (version) ON TABLE supabase_migrations.schema_migrations TO backup_ro;
  END IF;
END;
$$;

-- Only a role that already has BYPASSRLS can hand that attribute on, so try it first, and
-- fall back to a policy on each table with row level security. history.row_versions has it
-- too, so it needs one like any other.
DO $$
DECLARE
  v_table record;
BEGIN
  IF NOT (SELECT rolbypassrls FROM pg_catalog.pg_roles WHERE rolname = 'backup_ro') THEN
    BEGIN
      ALTER ROLE backup_ro BYPASSRLS;
    EXCEPTION WHEN insufficient_privilege THEN
      NULL;
    END;
  END IF;

  IF (SELECT rolbypassrls FROM pg_catalog.pg_roles WHERE rolname = 'backup_ro') THEN
    RETURN;
  END IF;

  FOR v_table IN
    SELECT n.nspname, c.relname
    FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname IN ('public', 'history')
      AND c.relkind IN ('r', 'p')
      AND c.relrowsecurity
      AND NOT EXISTS (
        SELECT 1 FROM pg_catalog.pg_policy p
        WHERE p.polrelid = c.oid AND p.polname = 'backup_ro_read'
      )
  LOOP
    EXECUTE format(
      'CREATE POLICY backup_ro_read ON %I.%I FOR SELECT TO backup_ro USING (true)',
      v_table.nspname,
      v_table.relname
    );
  END LOOP;
END;
$$;

-- The same test backup/run-backup.sh applies, so a recovery does not end with a project the
-- next backup would refuse.
DO $$
DECLARE
  v_role record;
  v_unreadable bigint;
  v_hidden bigint;
BEGIN
  SELECT oid, rolbypassrls INTO v_role
  FROM pg_catalog.pg_roles WHERE rolname = 'backup_ro';

  SELECT count(*) INTO v_unreadable
  FROM pg_catalog.pg_class c
  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
  WHERE n.nspname IN ('public', 'history')
    AND c.relkind IN ('r', 'p')
    AND NOT pg_catalog.has_table_privilege(v_role.oid, c.oid, 'SELECT');

  SELECT count(*) INTO v_hidden
  FROM pg_catalog.pg_class c
  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
  WHERE n.nspname IN ('public', 'history')
    AND c.relkind IN ('r', 'p')
    AND c.relrowsecurity
    AND NOT v_role.rolbypassrls
    AND (
      NOT EXISTS (
        SELECT 1 FROM pg_catalog.pg_policy p
        WHERE p.polrelid = c.oid AND p.polpermissive AND p.polcmd IN ('r', '*')
          AND (v_role.oid = ANY (p.polroles) OR 0::oid = ANY (p.polroles))
          AND pg_catalog.pg_get_expr(p.polqual, p.polrelid) = 'true')
      OR EXISTS (
        SELECT 1 FROM pg_catalog.pg_policy p
        WHERE p.polrelid = c.oid AND NOT p.polpermissive AND p.polcmd IN ('r', '*')
          AND (v_role.oid = ANY (p.polroles) OR 0::oid = ANY (p.polroles)))
    );

  IF v_unreadable > 0 THEN
    RAISE EXCEPTION 'backup_ro cannot read % tables', v_unreadable;
  END IF;
  IF v_hidden > 0 THEN
    RAISE EXCEPTION 'row level security hides % tables from backup_ro', v_hidden;
  END IF;
END;
$$;
