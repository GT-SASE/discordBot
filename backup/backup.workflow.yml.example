# Template for .github/workflows/backup.yml in the private backups repo. It is kept here
# so it is versioned and lintable, and must not run in this repo, which never holds
# database secrets. docs/BACKUPS.md has the setup steps.
#
# Before using it, replace both AGE_RECIPIENT placeholders. The job refuses to run until
# they are real public keys. Private keys never go in this repo or its secrets.

name: Backup

on:
  schedule:
    # Off the hour, when GitHub's scheduled runs are least often delayed, and before the
    # reminder job's morning window.
    - cron: "17 9 * * *"
  workflow_dispatch:
    inputs:
      accept_drop_reason:
        description: "Why a large fall in row counts is expected. Leave empty unless a run failed for this."
        required: false
        type: string

permissions:
  contents: read

concurrency:
  group: backup
  cancel-in-progress: false

defaults:
  run:
    shell: bash

env:
  AGE_VERSION: v1.3.2
  AGE_LINUX_AMD64_SHA256: cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
  # Pinned to a patched release, 17.6 or later, for CVE-2025-8714 and CVE-2025-8715.
  # run-backup.sh also checks the installed version.
  PG_CLIENT_VERSION: 17.11-1.pgdg24.04+2
  PGDG_SIGNER_SHA512: f90aa7e1edb46fbe31d46c2e7138437e7fa6444c33b7dc1c70e9d655992504f860e6d6bba2d64954d648463849ea4d9d2f6db92159fa8c54b35555a232597ac7

jobs:
  backup:
    # A manual run from another branch would commit a backup to that branch. Scheduled
    # runs use the default branch, which must be main for this job to run at all.
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: write
    steps:
      # The token stays out of .git/config, and out of reach of the database steps.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install the PostgreSQL client
        run: |
          key="${RUNNER_TEMP}/pgdg.asc"
          curl -fsSL --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors --retry-delay 2 --max-time 60 -o "${key}" https://www.postgresql.org/media/keys/ACCC4CF8.asc
          echo "${PGDG_SIGNER_SHA512}  ${key}" | sha512sum --check --strict
          sudo install -D -m 0644 "${key}" /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
          # A release moves to the archive once it is superseded, so the pin needs both.
          {
            echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main"
            echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt-archive.postgresql.org/pub/repos/apt noble-pgdg-archive main"
          } | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
          sudo apt-get -o Acquire::Retries=5 update -qq
          sudo apt-get -o Acquire::Retries=5 install -y -qq --no-install-recommends "postgresql-client-17=${PG_CLIENT_VERSION}"
          echo /usr/lib/postgresql/17/bin >>"${GITHUB_PATH}"

      - name: Install age
        run: |
          tarball="${RUNNER_TEMP}/age.tar.gz"
          curl -fsSL --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors --retry-delay 2 --max-time 120 -o "${tarball}" \
            "https://github.com/FiloSottile/age/releases/download/${AGE_VERSION}/age-${AGE_VERSION}-linux-amd64.tar.gz"
          echo "${AGE_LINUX_AMD64_SHA256}  ${tarball}" | sha256sum --check --strict
          tar -xzf "${tarball}" -C "${RUNNER_TEMP}" age/age
          sudo install -m 0755 "${RUNNER_TEMP}/age/age" /usr/local/bin/age

      - name: Dump, encrypt and check
        run: bash backup/run-backup.sh
        env:
          PGHOST: ${{ secrets.BACKUP_PGHOST }}
          PGPORT: "5432"
          PGDATABASE: postgres
          PGUSER: ${{ secrets.BACKUP_PGUSER }}
          PGPASSWORD: ${{ secrets.BACKUP_PGPASSWORD }}
          PGSSLMODE: verify-full
          PGSSLROOTCERT: backup/supabase-ca.pem
          # Public keys, one per key holder.
          AGE_RECIPIENT_1: REPLACE_WITH_FIRST_HOLDER_PUBLIC_KEY
          AGE_RECIPIENT_2: REPLACE_WITH_SECOND_HOLDER_PUBLIC_KEY
          # Optional. Set only during a handoff, for the incoming maintainer's key.
          AGE_RECIPIENT_3: ""
          ACCEPT_DROP_REASON: ${{ inputs.accept_drop_reason }}

      - name: Commit the encrypted backup
        run: |
          git add backups
          git -c user.name="github-actions[bot]" \
            -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
            commit -q -m "backup: $(date -u +%Y-%m-%dT%H:%MZ)"
          # shellcheck disable=SC2016
          git -c credential.helper= \
            -c credential.helper='!f() { echo username=x-access-token; echo "password=${GITHUB_TOKEN}"; }; f' \
            push -q origin "HEAD:${GITHUB_REF_NAME}"
        env:
          GITHUB_TOKEN: ${{ github.token }}

      # Runs after the commit, and even if the backup failed. A stopped reminder job is
      # no reason to lose today's backup, and a failed backup should not hide it.
      - name: Check that reminders are still running
        if: ${{ always() && vars.REMINDER_CHECK != 'off' }}
        run: bash backup/check-freshness.sh
        env:
          PGHOST: ${{ secrets.BACKUP_PGHOST }}
          PGPORT: "5432"
          PGDATABASE: postgres
          PGUSER: ${{ secrets.BACKUP_PGUSER }}
          PGPASSWORD: ${{ secrets.BACKUP_PGPASSWORD }}
          PGSSLMODE: verify-full
          PGSSLROOTCERT: backup/supabase-ca.pem

      # Optional. A workflow that stops being scheduled cannot report its own failure, so
      # a dead-man's switch elsewhere has to notice the silence. Sends no data.
      - name: Send the heartbeat
        run: |
          if [[ -n "${HEARTBEAT_URL}" ]]; then
            curl -fsS --proto '=https' --retry 5 --retry-all-errors --retry-delay 2 --max-time 15 -o /dev/null "${HEARTBEAT_URL}"
          fi
        env:
          HEARTBEAT_URL: ${{ secrets.BACKUP_HEARTBEAT_URL }}
