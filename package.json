{
  "name": "gtsase-discord-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Discord bot that tracks events, tasks and deadlines for a student organisation's events team.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "gitleaks:install": "bash scripts/install-gitleaks.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && bash scripts/check-discord-urls.sh",
    "lint:lockfile": "node scripts/check-lockfile.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "db:migrate": "node scripts/migrate.ts",
    "commands:register": "node --env-file-if-exists=.env scripts/register-commands.ts"
  },
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@vercel/functions": "2.2.13",
    "discord-api-types": "0.38.57",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
