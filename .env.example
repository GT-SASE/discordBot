# Copy to .env for local work. .env is ignored by git; never commit real values.
# In deployed environments, set these in the Vercel project settings instead.

# Discord application ID. Not secret.
# Source: Discord Developer Portal > your application > General Information.
DISCORD_APP_ID=

# Key used to verify the signature on incoming interactions. Not secret.
# Source: Discord Developer Portal > your application > General Information.
DISCORD_PUBLIC_KEY=

# Bot token. SECRET.
# Source: Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# Comma-separated IDs of the Discord servers the bot may serve. Everything else
# is refused. Not secret, but club-specific: keep real IDs out of the repo.
# Source: Discord > Server Settings > Widget, or Copy Server ID in developer mode.
ALLOWED_GUILD_IDS=

# Supabase project URL. Not secret.
# Source: Supabase dashboard > your project > Project Settings > API.
SUPABASE_URL=

# Server-side database key that bypasses row level security. SECRET.
# Source: Supabase dashboard > your project > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Shared secret that protects the cron endpoint. SECRET. Vercel sends it as a bearer
# token. Under 32 characters, or unset, the endpoint refuses every request.
# Source: generate your own, for example with: openssl rand -hex 32
CRON_SECRET=
